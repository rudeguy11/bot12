# Required
MC_SERVER_HOST=your-server.example
MC_SERVER_PORT=25565

# Use "offline" only for a server configured for offline authentication.
MC_AUTH_MODE=offline
MC_USERNAME=pampa

# For an online-mode server, use:
# MC_AUTH_MODE=online
# MC_USERNAME=your-minecraft-name
# MC_UUID=your-minecraft-uuid
# MC_ACCESS_TOKEN=your-valid-microsoft-minecraft-access-token

# Optional existing bot settings:
GEMINI_API_KEY=
